{
    "files.associations": {
        "string": "cpp",
        "stdexcept": "cpp",
        "__node_handle": "cpp",
        "__tree": "cpp",
        "__verbose_abort": "cpp",
        "cmath": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "initializer_list": "cpp",
        "iosfwd": "cpp",
        "iostream": "cpp",
        "limits": "cpp",
        "map": "cpp",
        "new": "cpp",
        "string_view": "cpp",
        "typeinfo": "cpp",
        "variant": "cpp",
        "array": "cpp",
        "execution": "cpp",
        "ios": "cpp",
        "istream": "cpp",
        "optional": "cpp",
        "ratio": "cpp",
        "streambuf": "cpp",
        "unordered_map": "cpp",
        "memory": "cpp",
        "algorithm": "cpp"
    },
    "FSharp.suggestGitignore": false,
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.configurationWarnings": "enabled",
    "cmake.configureOnOpen": false,
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.files.exclude": {
        "**/.vscode": true,
        "**/.git": true,
        "${workspaceFolder}/build/CMakeFiles": true,
        "${workspaceFolder}/bin": true,
        "${workspaceFolder}/documentacion": true
    },
    "C_Cpp.loggingLevel": "Debug"
}

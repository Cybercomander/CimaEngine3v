{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CimaEngine3v: build Debug",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/build --config Debug --target CimaEngine3v",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CimaEngine3v: build Release",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/build --config Release --target CimaEngine3v",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}